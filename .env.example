# ─────────────────────────────────────────────────────────────────────────────
# Lawn Care Instant Estimate — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values (see .gitignore).
# Every key below is SERVER-SIDE ONLY and must never reach the client bundle.
# When a key is unset, the app falls back to dev mock data so the flow still runs.
# ─────────────────────────────────────────────────────────────────────────────

# Regrid (Typeahead + Parcel APIs) — https://regrid.com/api
REGRID_API_TOKEN=

# Google Maps Static API — satellite thumbnails (server-proxied)
GOOGLE_MAPS_API_KEY=

# Supabase — Postgres (lookup cache, config, leads) + Auth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# These two are exposed to the browser for cookie-based Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — contractor lead notifications (Milestone 6)
RESEND_API_KEY=

# Stripe — optional deposit (Milestone 6)
STRIPE_SECRET_KEY=
